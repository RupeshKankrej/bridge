{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bridge.local/protocol/pair.request.json",
  "title": "pair.request payload",
  "type": "object",
  "required": ["fingerprint", "confirmCode"],
  "properties": {
    "fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$", "description": "sender's certificate SHA-256, lowercase hex" },
    "confirmCode": { "type": "string", "pattern": "^[0-9]{6}$" }
  },
  "additionalProperties": false
}
